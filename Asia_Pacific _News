from eventregistry import *

from reportlab.platypus import (
    SimpleDocTemplate,
    Paragraph,
    Spacer
)

from reportlab.lib.styles import (
    getSampleStyleSheet,
    ParagraphStyle
)

from reportlab.lib.pagesizes import letter
from reportlab.lib import colors

from datetime import datetime
from html import unescape

import re
import os

# =========================================================
# 🔑 EVENT REGISTRY API KEY
# =========================================================

API_KEY = "c65ceb3b-67a9-415d-aa3a-b68fb0751ee4"

er = EventRegistry(apiKey=API_KEY)

# =========================================================
# 📅 DATE MODE
# =========================================================
# OPTIONS:
#   "today"
#   "range"

date_mode = "today"

# Used only if mode = "range"
date_start = "2026-05-01"
date_end = "2026-05-05"

# =========================================================
# 📅 DATE LOGIC
# =========================================================

if date_mode == "today":

    today = datetime.now().strftime("%Y-%m-%d")

    date_start = today
    date_end = today

    print(f"\n📅 TODAY MODE ENABLED: {today}")

elif date_mode == "range":

    print(f"\n📅 DATE RANGE: {date_start} → {date_end}")

else:

    raise ValueError(
        "❌ Invalid date_mode. Use 'today' or 'range'."
    )

# =========================================================
# 🌏 ASIA PACIFIC COUNTRIES
# =========================================================

india = er.getLocationUri("India")
china = er.getLocationUri("China")
japan = er.getLocationUri("Japan")
south_korea = er.getLocationUri("South Korea")
australia = er.getLocationUri("Australia")
new_zealand = er.getLocationUri("New Zealand")

singapore = er.getLocationUri("Singapore")
indonesia = er.getLocationUri("Indonesia")
malaysia = er.getLocationUri("Malaysia")
thailand = er.getLocationUri("Thailand")
philippines = er.getLocationUri("Philippines")
vietnam = er.getLocationUri("Vietnam")

location_uri = QueryItems.OR([
    india,
    china,
    japan,
    south_korea,
    australia,
    new_zealand,
    singapore,
    indonesia,
    malaysia,
    thailand,
    philippines,
    vietnam
])

print("\n🌏 Fetching ASIA PACIFIC Trending News...\n")

# =========================================================
# 🧠 QUERY SETUP
# =========================================================

q = QueryArticlesIter(
    sourceLocationUri=location_uri,
    lang="eng",
    dateStart=date_start,
    dateEnd=date_end,
    isDuplicateFilter="skipDuplicates"
)

# =========================================================
# 📄 PDF FILE SETUP
# =========================================================

timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")

pdf_file = f"asia_pacific_news_report_{timestamp}.pdf"

doc = SimpleDocTemplate(
    pdf_file,
    pagesize=letter,
    rightMargin=40,
    leftMargin=40,
    topMargin=40,
    bottomMargin=40
)

# =========================================================
# 🎨 MODERN COLOR COMBINATION
# =========================================================
# Theme:
#   Deep Indigo
#   Cyan Blue
#   Slate
#   Soft Grey

PRIMARY = colors.HexColor("#1E1B4B")      # Indigo
SECONDARY = colors.HexColor("#0284C7")    # Sky Blue
TEXT = colors.HexColor("#1F2937")         # Slate
LIGHT = colors.HexColor("#6B7280")        # Grey

# =========================================================
# 🎨 PDF STYLES
# =========================================================

styles = getSampleStyleSheet()

title_style = ParagraphStyle(
    name="TitleStyle",
    parent=styles["Title"],
    fontSize=24,
    leading=30,
    textColor=PRIMARY,
    spaceAfter=20
)

heading_style = ParagraphStyle(
    name="HeadingStyle",
    parent=styles["Heading2"],
    fontSize=15,
    leading=20,
    textColor=SECONDARY,
    spaceAfter=10
)

body_style = ParagraphStyle(
    name="BodyStyle",
    parent=styles["BodyText"],
    fontSize=11,
    leading=18,
    textColor=TEXT,
    spaceAfter=10
)

small_style = ParagraphStyle(
    name="SmallStyle",
    parent=styles["BodyText"],
    fontSize=9,
    leading=12,
    textColor=LIGHT
)

# =========================================================
# 📦 CONTENT HOLDER
# =========================================================

content = []

# =========================================================
# 📰 REPORT TITLE
# =========================================================

report_title = (
    f"🌏 Asia Pacific Trending News Report<br/>"
    f"{date_start} to {date_end}"
)

content.append(
    Paragraph(report_title, title_style)
)

content.append(
    Paragraph(
        f"Generated on: {datetime.now()}",
        small_style
    )
)

content.append(Spacer(1, 20))

# =========================================================
# 🧹 CLEAN FUNCTION
# =========================================================

def clean_text(text):

    if not text:
        return "N/A"

    # Remove HTML tags
    text = re.sub(r"<[^>]+>", "", text)

    # Decode HTML entities
    text = unescape(text)

    # Remove bad unicode chars
    text = text.replace("\x00", "")

    # Remove extra spaces
    text = re.sub(r"\s+", " ", text).strip()

    return text

# =========================================================
# 🔥 FETCH ARTICLES
# =========================================================

article_count = 0

try:

    for art in q.execQuery(
        er,
        sortBy="socialScore",
        maxItems=200
    ):

        article_count += 1

        # =================================================
        # SAFE FIELD EXTRACTION
        # =================================================

        title = clean_text(
            art.get("title", "N/A")
        )

        date = clean_text(
            art.get("date", "N/A")
        )

        source = "N/A"

        if art.get("source"):

            source = clean_text(
                art["source"].get(
                    "title",
                    "N/A"
                )
            )

        url = art.get("url", "")

        body = art.get("body", "")

        summary = art.get("summary", "")

        # =================================================
        # FALLBACK SUMMARY
        # =================================================

        if not body:
            body = summary

        if not body:
            body = "No summary available."

        body = clean_text(body)

        # Limit summary size
        body = body[:900]

        # =================================================
        # CONSOLE OUTPUT
        # =================================================

        print(f"{article_count}. 📰 {title}")

        # =================================================
        # ARTICLE TITLE
        # =================================================

        content.append(
            Paragraph(
                f"<b>{article_count}. {title}</b>",
                heading_style
            )
        )

        # =================================================
        # DATE
        # =================================================

        content.append(
            Paragraph(
                f"<b>📅 Date:</b> {date}",
                body_style
            )
        )

        # =================================================
        # SOURCE
        # =================================================

        content.append(
            Paragraph(
                f"<b>📰 Source:</b> {source}",
                body_style
            )
        )

        # =================================================
        # CLICKABLE URL
        # =================================================

        if url:

            safe_url = url.replace("&", "&amp;")

            content.append(
                Paragraph(
                    f'<b>🔗 URL:</b> '
                    f'<link href="{safe_url}">'
                    f'{safe_url}</link>',
                    body_style
                )
            )

        # =================================================
        # SUMMARY
        # =================================================

        content.append(
            Paragraph(
                f"<b>📄 Summary:</b><br/>{body}",
                body_style
            )
        )

        content.append(Spacer(1, 20))

except Exception as e:

    print("\n❌ ERROR FETCHING ARTICLES")
    print(str(e))

# =========================================================
# 📦 NO ARTICLES CASE
# =========================================================

if article_count == 0:

    content.append(
        Paragraph(
            "No articles found for selected dates.",
            body_style
        )
    )

# =========================================================
# 📄 BUILD PDF
# =========================================================

try:

    doc.build(content)

    print("\n======================================")
    print("✅ PDF GENERATED SUCCESSFULLY")
    print(f"📄 File: {os.path.abspath(pdf_file)}")
    print(f"📰 Total Articles: {article_count}")
    print("🌏 Asia Pacific Trending News Report Created")
    print("======================================\n")

except Exception as e:

    print("\n❌ PDF GENERATION FAILED")
    print(str(e))