from eventregistry import *
from reportlab.platypus import SimpleDocTemplate, Paragraph, Spacer
from reportlab.lib.styles import getSampleStyleSheet, ParagraphStyle
from datetime import datetime

# ==============================
# 🔑 CONFIGURATION
# ==============================

# API key
er = EventRegistry(apiKey="c65ceb3b-67a9-415d-aa3a-b68fb0751ee4")

# 🔥 DATE MODE SWITCH
# Options: "today" OR "range"
date_mode = "today"

# 🔥 DATE RANGE (used only if mode = "range")
date_start = "2026-05-01"
date_end   = "2026-05-05"

# ==============================
# 📅 DATE HANDLING LOGIC
# ==============================

if date_mode == "today":
    today = datetime.now().strftime("%Y-%m-%d")
    date_start = today
    date_end = today
    print(f"\n📅 Using TODAY mode: {today}\n")

elif date_mode == "range":
    print(f"\n📅 Using DATE RANGE: {date_start} → {date_end}\n")

else:
    raise ValueError("Invalid date_mode. Use 'today' or 'range'.")

# ==============================
# 🌍 LOCATION CONFIG
# ==============================

# ✅ INDIA (default)
# location_uri = er.getLocationUri("India")

# 🌎 GLOBAL (uncomment below)
# location_uri = None

# 🌍 OTHER COUNTRY (example)
location_uri = er.getLocationUri("China")

# ==============================
# 🧠 QUERY SETUP
# ==============================

if location_uri:
    q = QueryArticlesIter(
        sourceLocationUri=location_uri,
        lang="eng",
        dateStart=date_start,
        dateEnd=date_end,
        isDuplicateFilter="skipDuplicates"
    )
else:
    q = QueryArticlesIter(
        lang="eng",
        dateStart=date_start,
        dateEnd=date_end,
        isDuplicateFilter="skipDuplicates"
    )

# ==============================
# 📄 PDF SETUP
# ==============================

doc = SimpleDocTemplate("news_report.pdf")
styles = getSampleStyleSheet()

custom_style = ParagraphStyle(
    name="Custom",
    parent=styles["Normal"],
    fontSize=styles["Normal"].fontSize + 3,
    leading=15
)

title_style = ParagraphStyle(
    name="TitleCustom",
    parent=styles["Title"],
    fontSize=styles["Title"].fontSize + 4
)

content = []

# Title
content.append(Paragraph(
    f"News Report ({date_start} to {date_end})",
    title_style
))
content.append(Spacer(1, 12))

# ==============================
# 🔥 FETCH ARTICLES
# ==============================

for art in q.execQuery(
    er,
    sortBy="socialScore",   # trending
    maxItems=200
):

    title = art.get("title", "N/A")
    date = art.get("date", "N/A")
    source = art.get("source", {}).get("title", "N/A")
    url = art.get("url", "")
    body = art.get("body", "")

    # Console
    print("📰", title)

    # PDF content
    content.append(Paragraph(f"<b>Title:</b> {title}", custom_style))
    content.append(Paragraph(f"<b>Date:</b> {date}", custom_style))
    content.append(Paragraph(f"<b>Source:</b> {source}", custom_style))
    content.append(Paragraph(f"<b>URL:</b> {url}", custom_style))
    content.append(Paragraph(f"<b>Summary:</b> {body[:300]}...", custom_style))
    content.append(Spacer(1, 14))

# ==============================
# 📦 BUILD PDF
# ==============================

doc.build(content)

print("\n✅ PDF generated: news_report.pdf\n")