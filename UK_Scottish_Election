from eventregistry import *

from reportlab.platypus import (
    SimpleDocTemplate,
    Paragraph,
    Spacer,
    HRFlowable,
    PageBreak
)

from reportlab.lib.styles import (
    getSampleStyleSheet,
    ParagraphStyle
)

from reportlab.lib.pagesizes import letter

from reportlab.lib import colors

from datetime import datetime

from html import unescape

import re
import os

# =========================================================
# 🔑 EVENT REGISTRY API KEY
# =========================================================

er = EventRegistry(
    apiKey="c65ceb3b-67a9-415d-aa3a-b68fb0751ee4"
)

# =========================================================
# 📅 DATE MODE
# =========================================================
# OPTIONS:
#   "today"
#   "range"

date_mode = "today"

# Used only if mode = "range"

date_start = "2026-05-01"
date_end = "2026-05-05"

# =========================================================
# 📅 DATE LOGIC
# =========================================================

if date_mode == "today":

    today = datetime.now().strftime("%Y-%m-%d")

    date_start = today
    date_end = today

    print(f"\n📅 TODAY MODE ENABLED: {today}")

elif date_mode == "range":

    print(f"\n📅 DATE RANGE: {date_start} → {date_end}")

else:

    raise ValueError(
        "❌ Invalid date_mode"
    )

# =========================================================
# 🔥 CONCEPTS
# =========================================================

print("\n🔥 Loading UK political concepts...\n")

election_uri = er.getConceptUri("election")

vote_uri = er.getConceptUri("voting")

politics_concept = er.getConceptUri("politics")

uk_politics_uri = er.getConceptUri("United Kingdom politics")

scotland_uri = er.getConceptUri("Scotland")

concepts = QueryItems.OR([

    election_uri,

    vote_uri,

    politics_concept,

    uk_politics_uri,

    scotland_uri

])

# =========================================================
# 🇬🇧 LOCATION CONFIG
# =========================================================

politics_uri = er.getCategoryUri("politics")

uk_location = er.getLocationUri(
    "United Kingdom"
)

scotland_location = er.getLocationUri(
    "Scotland"
)

location_uri = QueryItems.OR([

    uk_location,

    scotland_location

])

# =========================================================
# 🧠 QUERY
# =========================================================

q = QueryArticlesIter(

    conceptUri=concepts,

    categoryUri=politics_uri,

    sourceLocationUri=location_uri,

    lang="eng",

    dateStart=date_start,

    dateEnd=date_end,

    isDuplicateFilter="skipDuplicates"
)

print(
    "\n🔥 UK & Scotland Political News "
    "(200 Articles | All Sources)\n"
)

# =========================================================
# 📄 PDF FILE
# =========================================================

timestamp = datetime.now().strftime(
    "%Y%m%d_%H%M%S"
)

pdf_file = (
    f"uk_scotland_political_news_{timestamp}.pdf"
)

doc = SimpleDocTemplate(

    pdf_file,

    pagesize=letter,

    rightMargin=35,

    leftMargin=35,

    topMargin=35,

    bottomMargin=35
)

# =========================================================
# 🎨 UK-THEMED PDF COLORS
# =========================================================

PRIMARY = colors.HexColor("#012169")      # UK Blue
SECONDARY = colors.HexColor("#C8102E")    # UK Red
TEXT = colors.HexColor("#222222")
LIGHT = colors.HexColor("#666666")

# =========================================================
# 🎨 PDF STYLES
# =========================================================

styles = getSampleStyleSheet()

# ---------------------------------------------------------
# TITLE STYLE
# ---------------------------------------------------------

title_style = ParagraphStyle(

    name="TitleStyle",

    parent=styles["Title"],

    fontSize=30,

    leading=38,

    alignment=1,

    textColor=PRIMARY,

    spaceAfter=22
)

# ---------------------------------------------------------
# ARTICLE HEADING STYLE
# ---------------------------------------------------------

heading_style = ParagraphStyle(

    name="HeadingStyle",

    parent=styles["Heading2"],

    fontSize=17,

    leading=24,

    textColor=SECONDARY,

    spaceAfter=10
)

# ---------------------------------------------------------
# BODY STYLE
# ---------------------------------------------------------

custom_style = ParagraphStyle(

    name="Custom",

    parent=styles["BodyText"],

    fontSize=13,

    leading=22,

    textColor=TEXT,

    spaceAfter=12
)

# ---------------------------------------------------------
# SMALL STYLE
# ---------------------------------------------------------

small_style = ParagraphStyle(

    name="SmallStyle",

    parent=styles["BodyText"],

    fontSize=10,

    leading=14,

    textColor=LIGHT
)

# ---------------------------------------------------------
# HIGHLIGHT STYLE
# ---------------------------------------------------------

highlight_style = ParagraphStyle(

    name="HighlightStyle",

    parent=styles["BodyText"],

    fontSize=13,

    leading=20,

    textColor=colors.white,

    backColor=PRIMARY,

    borderPadding=10,

    spaceAfter=16
)

# =========================================================
# 📦 CONTENT HOLDER
# =========================================================

content = []

# =========================================================
# 📰 REPORT TITLE
# =========================================================

report_title = (
    "🇬🇧 UK & Scotland Political News Report"
)

content.append(
    Paragraph(
        report_title,
        title_style
    )
)

content.append(
    Paragraph(
        f"<b>Generated:</b> "
        f"{datetime.now()}",
        highlight_style
    )
)

content.append(
    Paragraph(
        "🔥 Trending political, election "
        "and voting news from UK & Scotland",
        small_style
    )
)

content.append(
    Spacer(1, 18)
)

# =========================================================
# ➖ DIVIDER
# =========================================================

content.append(
    HRFlowable(
        width="100%",
        thickness=3,
        color=SECONDARY
    )
)

content.append(
    Spacer(1, 20)
)

# =========================================================
# 🔥 FETCH ARTICLES
# =========================================================

article_count = 0

try:

    for art in q.execQuery(

        er,

        sortBy="socialScore",

        maxItems=200
    ):

        article_count += 1

        # =================================================
        # SAFE EXTRACTION
        # =================================================

        title = art.get(
            "title",
            "N/A"
        )

        date = art.get(
            "date",
            "N/A"
        )

        source = art.get(
            "source",
            {}
        ).get(
            "title",
            "N/A"
        )

        url = art.get(
            "url",
            ""
        )

        body = art.get(
            "body",
            ""
        )

        summary = art.get(
            "summary",
            ""
        )

        # =================================================
        # FALLBACKS
        # =================================================

        if not body:
            body = summary

        if not body:
            body = "No summary available."

        # =================================================
        # CLEAN HTML / XML
        # =================================================

        body = re.sub(
            r"<[^>]+>",
            "",
            body
        )

        body = unescape(body)

        body = body.replace(
            "\x00",
            ""
        )

        body = re.sub(
            r"\s+",
            " ",
            body
        ).strip()

        body = body[:1500]

        title = re.sub(
            r"<[^>]+>",
            "",
            title
        )

        title = unescape(title)

        # =================================================
        # CONSOLE OUTPUT
        # =================================================

        print(f"\n📰 ARTICLE {article_count}")

        print(f"📌 Title: {title}")

        print(f"📅 Date: {date}")

        print(f"🏢 Source: {source}")

        print(f"🌐 URL: {url}")

        print(f"📄 Summary: {body[:250]}...")

        print("-" * 100)

        # =================================================
        # PDF CONTENT
        # =================================================

        content.append(
            Paragraph(
                f"<b>{article_count}. "
                f"{title}</b>",
                heading_style
            )
        )

        content.append(
            Paragraph(
                f"<b>📅 Date:</b> "
                f"{date}",
                custom_style
            )
        )

        content.append(
            Paragraph(
                f"<b>🏢 Source:</b> "
                f"{source}",
                custom_style
            )
        )

        # -------------------------------------------------
        # SAFE URL
        # -------------------------------------------------

        if url:

            safe_url = url.replace(
                "&",
                "&amp;"
            )

            content.append(
                Paragraph(
                    f'<b>🌐 URL:</b> '
                    f'<link href="{safe_url}">'
                    f'{safe_url}</link>',
                    custom_style
                )
            )

        # -------------------------------------------------
        # SUMMARY
        # -------------------------------------------------

        content.append(
            Paragraph(
                f"<b>📄 Summary:</b><br/>"
                f"{body}",
                custom_style
            )
        )

        content.append(
            Spacer(1, 18)
        )

        content.append(
            HRFlowable(
                width="100%",
                thickness=1,
                color=colors.HexColor("#DDDDDD")
            )
        )

        content.append(
            Spacer(1, 16)
        )

        # -------------------------------------------------
        # PAGE BREAK EVERY 15 ARTICLES
        # -------------------------------------------------

        if article_count % 15 == 0:

            content.append(
                PageBreak()
            )

except Exception as e:

    print("\n❌ ERROR FETCHING ARTICLES")

    print(str(e))

# =========================================================
# 📦 EMPTY RESULT
# =========================================================

if article_count == 0:

    content.append(
        Paragraph(
            "No political articles found.",
            custom_style
        )
    )

# =========================================================
# 📄 BUILD PDF
# =========================================================

try:

    doc.build(content)

    print("\n========================================")

    print("✅ PDF GENERATED SUCCESSFULLY")

    print(
        f"📄 File: "
        f"{os.path.abspath(pdf_file)}"
    )

    print(
        f"📰 Total Articles: "
        f"{article_count}"
    )

    print(
        "🇬🇧 UK & Scotland Political "
        "News Report Created"
    )

    print("========================================\n")

except Exception as e:

    print("\n❌ PDF GENERATION FAILED")

    print(str(e))